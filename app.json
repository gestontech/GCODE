{
  "expo": {
    "name": "GCODE",
    "slug": "gcode",
    "version": "3.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "gcode",

    "icon": "./assets/gcode-icon-new.png",

    "platforms": [
      "android",
      "ios",
      "web"
    ],

    "android": {
      "package": "com.gcode.mobile",
      "versionCode": 3,
      "userInterfaceStyle": "dark",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/gcode-icon-new.png",
        "backgroundColor": "#070914"
      }
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gcode.mobile",
      "icon": "./assets/gcode-icon-new.png"
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/gcode-favicon-new.png"
    }
  }
}
